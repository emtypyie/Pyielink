# PYIELINK FRAMEWORK — docker env example
# Copy to `.env` and fill in.
PYIELINK_DL_PORT=4243

# Required for the `view` service: IP of the host running pyielink.
PYIELINK_HOST=192.168.1.50

# Optional fixed session key. Leave empty to auto-generate + persist in the
# pyielink-data volume (host and view then share it automatically).
PYIELINK_KEY=
